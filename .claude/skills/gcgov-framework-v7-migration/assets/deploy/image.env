# The pinned Release. Written by the deploy workflow on every deploy and committed here,
# so `git log` answers "what is running, and what was running before".
#
# Rolling back is putting a previous pair back and re-running the deploy workflow.
#
# Empty until the first deploy — a compose command will refuse to run without them,
# which is the intended behaviour rather than a failure.
PHP_IMAGE_DIGEST=
NGINX_IMAGE_DIGEST=
